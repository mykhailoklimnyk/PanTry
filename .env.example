# Скопіюй у .env і заповни. .env у .gitignore з першого дня — ADR-10.
#
# Коментарі тут не оздоба, і це виміряно 12.09: знятий заголовок звалив
# ворота `secrets`. gitleaks читає ПОРОЖНІЙ ключ, у назві якого стоїть
# слово про секрет (`KOMORA_MCP_TOKEN=`), разом із тим, що йде за ним
# через кілька пробільних символів, -- і вважає значенням ІМ'Я сусіднього
# ключа. Розсуває їх саме коментар; порожній рядок не рахується.

# --- База ---------------------------------------------------------------
# Локально піднімається через `docker compose up -d db` (Postgres 18.4).
# Три рядки нижче читає compose; той самий логін і пароль -- у DSN.
POSTGRES_USER=komora
POSTGRES_PASSWORD=зміни-мене
POSTGRES_DB=komora
KOMORA_DATABASE_URL=postgresql://komora:зміни-мене@localhost:5433/komora

# --- MCP «Сільпо» -------------------------------------------------------
KOMORA_MCP_URL=https://mcp.silpo.ua/mcp
# Токен ОПЕРАТОРА (твій власний), отриманий `scripts/mcp_login.py`. Ним ходять
# крони слотів і залишків — це дані магазину, а не чийсь акаунт, — і CLI
# `first_basket.py`. Серверно, ніколи не на фронт — ADR-02.
#
# Застосунок ним НЕ користується: гість возить свій токен у cookie. Відкат на
# цей токен там, де гість не підключився, був би найтихішим багом продукту.
KOMORA_MCP_TOKEN=

# Філія кошика. Береться з silpo_get_shopping_cart_by_id → shipments[0].branchId
# УВАГА: вказує на район проживання → в публічні фікстури не потрапляє (ADR-03).
KOMORA_BRANCH_ID=

# --- Bedrock (ярус 3: тільки інференс) ----------------------------------
# Перевірено 12.08.2026: ключ автентифікується, але доступу до моделей на
# акаунті ще немає — усі віддають 403 permission_error. Вмикається в
# Bedrock console → Model access. Деталі й команда перевірки: docs/deploy.md
#
# Імена без префікса KOMORA_ — це стандартні змінні Anthropic SDK.
#
# УВАГА: регіон має бути us-east-1. У us-west-2 і eu-central-1 mantle віддає
# на ті самі model id 404 — тобто AWS_REGION=eu-central-1 тут не спрацює.
ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1

# Model id на Bedrock — З ПРЕФІКСОМ `anthropic.`. Без нього 404.
ANTHROPIC_MODEL_MAIN=anthropic.claude-opus-4-8
ANTHROPIC_MODEL_CHEAP=anthropic.claude-haiku-4-5

# --- Вхід гостя ---------------------------------------------------------
# Ключ, яким шифрується сесія гостя в cookie і копія доступу під нагляд крона.
# Порожній — вхід ВИМКНЕНИЙ, і це навмисно гучно: мовчазний відкат на
# відкритий текст був би найгіршим із можливих дефолтів.
#
#   uv run python -c "from komora.auth.crypto import generate_key; print(generate_key())"
KOMORA_SESSION_KEY=

# Наш публічний домен. Звідси будується redirect_uri — не з заголовка Host:
# його підставляє клієнт, а туди поїде код авторизації.
KOMORA_PUBLIC_URL=https://pantry.klimnyk.dev

# client_id динамічної реєстрації, отриманий ОДИН раз на продукт. Порожній —
# зареєструємось на льоту, але це шлях для чистої машини: сервер не повертає
# registration_access_token, тож прибрати за собою нічим.
KOMORA_OAUTH_CLIENT_ID=

# На скільки ПАРАЛЕЛЬНИХ пачок різати головний виклик агента (#199).
# 1 — як було, один запит на весь кошик. 2 дали 15,6 -> 3,7 с при тих самих
# грошах (замір 30.08): вхід ділиться між пачками, а коротший контекст ще й
# декодиться швидше. Важіль саме Mistral — на claude-haiku-4-5 пачки не
# допомагають (7,8 -> 7,0 с).
#
# ТИМЧАСОВИЙ, до перемикача «швидкі відповіді» (#198): той знає модель і
# вирішує сам. Ціна пачок названа в core/batching.py — черга різу під межу
# зшивається з двох половин, бо кожна бачила лише свою.
KOMORA_PICK_BATCHES=1

# Журнал прогону в runs/ (запит, кошик, трейс, вибори агента з причинами).
# Вимкнений: файл потрібен, коли прогін РОЗБИРАЮТЬ, а не на кожну збірку.
# З CLI вмикається на один прогін: `scripts/first_basket.py ... --log`.
# Тут — лише для сервера, коли треба зловити живий кейс із кнопки.
KOMORA_RUN_LOG=false

# --- Сповіщення крона (#236) --------------------------------------------
# Тижневий обхід каталогу звітує сюди ЩОРАЗУ, а не лише на біді: джоб, який
# пише тільки на поломці, від зупиненого таймера не відрізнити. Туди ж
# systemd шле «упав юніт» через OnFailure=.
#
# Порожнє — сповіщень немає, і обхід каже це рядком у своєму звіті.
# Бот заводиться в @BotFather, chat id — з `getUpdates` після першого
# повідомлення боту.
KOMORA_TELEGRAM_TOKEN=
KOMORA_TELEGRAM_CHAT=

KOMORA_LOG_LEVEL=info
