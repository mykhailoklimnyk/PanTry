{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komora",
  "compatibility_date": "2026-08-12",

  "build": {
    "command": "npm run build"
  },

  "main": "./src/worker.ts",

  "vars": {
    "API_ORIGIN": "https://komora-live.klimnyk.dev"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",

    "run_worker_first": ["/api/*"]
  },

  "workers_dev": false,
  "preview_urls": false
}
