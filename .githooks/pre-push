#!/bin/sh

zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if git rev-parse --verify --quiet "${local_sha}^" >/dev/null; then
        echo "Пуш зупинено: $remote_ref веде на коміт з батьками." >&2
        echo "Назовні їде рівно один коміт без історії — дерево HEAD." >&2
        echo "Публікуй через: uv run python scripts/publish.py" >&2
        exit 1
    fi
done

exit 0
